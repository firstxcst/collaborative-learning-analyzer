# 环境变量配置模板
# 复制为 .env 后编辑。.env 位于**项目根目录**（由 pyproject.toml 定位）。
# 环境变量的优先级高于 .env 文件。
# 用 `cla paths` 可以查看当前实际使用的目录。

# ---------------------------------------------------------------- 语义分析
# LLM 提供者：openai / dashscope / vllm / heuristic
#   heuristic 为离线规则基线（不调用任何外部服务，不需要密钥）
LLM_PROVIDER=openai

# OpenAI 兼容接口（LLM_PROVIDER=openai 时必填）
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# 阿里云百炼 / DashScope（LLM_PROVIDER=dashscope 时必填）
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# QWEN_MODEL=qwen2.5-72b-instruct

# 本地部署的 OpenAI 兼容端点（LLM_PROVIDER=vllm）
# 注意：使用云端 LLM 意味着**学生对话转录文本会离开本机**。
# 若不能接受，请使用 vllm 指向本地模型，或使用 heuristic 离线基线。
# VLLM_ENDPOINT=http://localhost:8000/v1
# VLLM_MODEL=default

# LLM 调用行为
# LLM_TEMPERATURE=0.0
# LLM_MAX_RETRIES=3
# LLM_MAX_PROMPT_CHARS=12000

# ---------------------------------------------------------------- 语音
# pyannote 说话人分离 token（从 huggingface.co 获取并接受用户协议）
# PYANNOTE_TOKEN=your-pyannote-token-here

# Whisper 设备。留空表示自动选择（cuda 可用则用 cuda）。
# 注意：不要填 "auto" —— torch 不接受这个设备字符串。
# WHISPER_DEVICE=cpu

# ---------------------------------------------------------------- 运行目录
# 默认是项目根目录下的 data/ results/ models/，可用以下变量覆盖
# CLA_PROJECT_ROOT=
# CLA_DATA_DIR=
# CLA_OUTPUT_DIR=
# CLA_MODELS_DIR=
