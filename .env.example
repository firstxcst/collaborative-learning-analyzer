# 环境变量配置

# OpenAI API（用于语义智能体）
OPENAI_API_KEY=your-openai-api-key-here

# DashScope API（用于 Qwen，可选）
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# pyannote Token（用于说话人分离，需要从 huggingface.co 获取）
# PYANNOTE_TOKEN=your-pyannote-token-here

# LLM 提供者选择：openai / dashscope / vllm
LLM_PROVIDER=openai

# vLLM 本地部署端点（可选）
# VLLM_ENDPOINT=http://localhost:8000/v1
