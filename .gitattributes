# 统一行尾，避免 Windows/Linux 之间产生无意义的整文件 diff
* text=auto eol=lf

# Windows 脚本必须保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.wav binary
*.mp4 binary
*.avi binary
*.mkv binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pt binary
*.pth binary
*.onnx binary
*.npy binary
*.npz binary
*.zip binary

# 生成的报告会被频繁比较，但不希望参与语言统计
results/*.json linguist-generated=true
fixtures/manifest.json linguist-generated=true

# 许可证全文不入语言统计
LICENSE linguist-vendored=true
